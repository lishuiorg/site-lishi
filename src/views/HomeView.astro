---
/* 首页：首屏、规模、六类内容、时间轴预览、最新更新、编纂凡例。 */
import Base from '../layouts/Base.astro';
import Hero from 'lishui-kit/astro/Hero.astro';
import StatBar from 'lishui-kit/astro/StatBar.astro';
import SectionHead from 'lishui-kit/astro/SectionHead.astro';
import CategoryGrid from 'lishui-kit/astro/CategoryGrid.astro';
import CardGrid from 'lishui-kit/astro/CardGrid.astro';
import TimelinePeriods from 'lishui-kit/astro/TimelinePeriods.astro';
import RulesList from 'lishui-kit/astro/RulesList.astro';
import { sectionPath } from 'lishui-kit/i18n/paths.mjs';
import { forLang } from 'lishui-kit';
import { ctxFor } from '../site/context.mjs';
import {
  siteContent, statsOf, ofCategory, onTimeline, byYear, byUpdated,
} from '../site/content.mjs';
import { CATEGORIES, PERIODS, RULES } from '../site/config.mjs';

const { lang } = Astro.props;
const ctx = ctxFor(lang);
const content = siteContent();
const { ui } = ctx;

const list = forLang(content.entries, lang);
const stats = statsOf(content, lang);
const timeline = list.filter(onTimeline).sort(byYear);
const latest = [...list].sort(byUpdated).slice(0, 6);

const homePath = sectionPath('home', lang);
const indexPath = sectionPath('index', lang);
const timelinePath = sectionPath('timeline', lang);

const statItems = ['entries', 'categories', 'dynasties', 'sources']
  .map((key) => ({ label: ui.stats[key], value: stats[key] }));

const catItems = CATEGORIES.map((cat) => {
  const items = ofCategory(content.entries, lang, cat.key);
  return {
    href: `${sectionPath(cat.dirName, lang)}#cat=${cat.key}`,
    glyph: cat.glyph,
    name: ctx.catName(cat),
    alt: cat.key,
    desc: ctx.catDesc(cat),
    count: items.length,
    countUnit: ui.list.countUnit,
    browseAll: ui.home.browseAll,
    empty: items.length === 0,
  };
});

const periods = PERIODS.map((period) => ({
  key: period.key,
  name: lang === 'zh' ? period.zh : period.en,
  range: lang === 'zh' ? period.range.zh : period.range.en,
  items: timeline.filter((entry) => entry.period?.key === period.key),
}));

const rules = RULES[lang].map(([no, title, text]) => ({ no, title, text }));
---

<Base
  lang={lang}
  path={homePath}
  title={ui.hero.title}
  description={ui.hero.lede}
  active="home"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: lang === 'zh' ? ctx.site.name : ctx.site.nameEn,
    url: `${ctx.site.origin}${homePath}`,
    inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
    description: ui.hero.lede,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${ctx.site.origin}${indexPath}#q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <Hero
    eyebrow={ui.hero.eyebrow}
    title={ui.hero.title}
    lede={ui.hero.lede}
    searchTarget={indexPath}
    searchPlaceholder={ui.hero.searchPlaceholder}
    searchLabel={ui.list.search}
    searchButton={ui.hero.searchButton}
    hint={ui.hero.searchHint}
  />

  <section class="section section--tight">
    <div class="wrap"><StatBar items={statItems} /></div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <SectionHead eyebrow="Browse" title={ui.home.categoriesTitle} note={ui.home.categoriesNote} />
      <CategoryGrid items={catItems} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="Timeline" title={ui.home.timelineTitle} note={ui.home.timelineNote} />
      <TimelinePeriods
        periods={periods}
        ctx={ctx}
        limit={2}
        emptyText={ui.timeline.empty}
        countUnit={ui.list.countUnit}
      />
      <p class="morelink"><a class="cat__go" href={timelinePath}>{ui.home.timelineOpen}</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <SectionHead eyebrow="Recent" title={ui.home.latestTitle} note={ui.home.latestNote} />
      <CardGrid entries={latest} ctx={ctx} />
      <p class="morelink"><a class="cat__go" href={indexPath}>{ui.home.latestSeeAll}</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="Editorial rules" title={ui.home.rulesTitle} note={ui.home.rulesNote} />
      <RulesList items={rules} />
    </div>
  </section>
</Base>
