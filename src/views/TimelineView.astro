---
/* 时间轴：按朝代分期的条目轴，只上有年份且精度可用的条目。 */
import Base from '../layouts/Base.astro';
import PageHead from 'lishui-kit/astro/PageHead.astro';
import FilterForm from 'lishui-kit/astro/FilterForm.astro';
import TimelinePeriods from 'lishui-kit/astro/TimelinePeriods.astro';
import { sectionPath } from 'lishui-kit/i18n/paths.mjs';
import { forLang } from 'lishui-kit';
import { ctxFor } from '../site/context.mjs';
import { siteContent, onTimeline, byYear } from '../site/content.mjs';
import { CATEGORIES, PERIODS } from '../site/config.mjs';

const { lang } = Astro.props;
const ctx = ctxFor(lang);
const content = siteContent();
const { ui } = ctx;

const list = forLang(content.entries, lang);
const onAxis = list.filter(onTimeline).sort(byYear);
const offAxis = list.filter((entry) => !onTimeline(entry));

const cats = CATEGORIES.filter((c) => onAxis.some((e) => e.category === c.key));
const groups = cats.length > 0 ? [{
  key: 'category',
  label: ui.timeline.filterCategory,
  options: cats.map((c) => ({ value: c.key, label: ctx.catName(c) })),
}] : [];

const periods = PERIODS.map((period) => ({
  key: period.key,
  name: lang === 'zh' ? period.zh : period.en,
  range: lang === 'zh' ? period.range.zh : period.range.en,
  items: onAxis.filter((entry) => entry.period?.key === period.key),
}));

const indexPath = sectionPath('index', lang);
---

<Base
  lang={lang}
  path={sectionPath('timeline', lang)}
  title={ui.timeline.title}
  description={ui.timeline.lede}
  active="timeline"
>
  <PageHead
    eyebrow={ui.nav.timeline}
    title={ui.timeline.title}
    lede={ui.timeline.lede}
    meta={[
      { label: ui.stats.entries, value: onAxis.length },
      { label: ui.timeline.periods, value: PERIODS.length },
    ]}
  />

  <section class="section">
    <div class="wrap">
      {groups.length > 0 && <FilterForm ui={ui} groups={groups} />}
      <TimelinePeriods
        periods={periods}
        ctx={ctx}
        searchable
        showTags
        emptyText={ui.timeline.empty}
        countUnit={ui.list.countUnit}
      />
      <p class="noresult" data-noresult data-visible="false">{ui.list.noresult}</p>
      {offAxis.length > 0 && (
        <p class="searchhint">
          {ui.timeline.offAxisNote.replace('{n}', String(offAxis.length))}{' '}
          <a href={indexPath}>{ui.nav.index}</a>
        </p>
      )}
    </div>
  </section>
</Base>
